{
  "name": "dsh-qwen-studio",
  "version": "3.0.2",
  "description": "完美适配 purge 的 nsfw content creation 插件",
  "type": "module",
  "author": "kingcharleslzy-ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingcharleslzy-ai/DSH-Spicy.git"
  },
  "bugs": {
    "url": "https://github.com/kingcharleslzy-ai/DSH-Spicy/issues"
  },
  "homepage": "https://github.com/kingcharleslzy-ai/DSH-Spicy#readme",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./video-host": "./video/index.js",
    "./film-host": "./film/index.js",
    "./video-client": "./video/client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "backend/server.py",
    "backend/normalize_image.py",
    "scripts/setup-local.sh",
    "skills/**/*.md",
    "docs/*.md",
    "NOTICE",
    "CHANGELOG.md",
    "backend/qwen_gateway.py",
    "backend/qwen_workflow.py",
    "backend/comfy_nodes/**/*.py",
    "LICENSES/*.txt",
    "README.en.md",
    "lib/maintenance.js",
    "bin/*.mjs",
    "scripts/prepare.mjs",
    "AGENTS.md",
    "backend/score_image.py",
    "scripts/npm-command.mjs",
    "scripts/setup-image-python.py",
    "docs/recipes/*.md",
    "video/*.js",
    "video/worker.py",
    "video/workflows/*.json",
    "video/vendor/**/*",
    "film/*.js",
    "film/**/*.py",
    "film/upstream_h3studio/LICENSE",
    "film/upstream_h3studio/REVISION",
    "film/requirements.txt",
    "scripts/check-h3-models.py",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "license": "Apache-2.0",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "qwen-image",
    "qwen-image-2.1",
    "mlx",
    "mflux",
    "apple-silicon",
    "local-ai",
    "image-generation",
    "text-to-image",
    "image-to-image",
    "lora",
    "controlnet",
    "inpainting",
    "private-gallery",
    "self-hosted",
    "minimax-h3",
    "video-generation",
    "reference-to-video",
    "storyboard",
    "filmmaking",
    "comfyui",
    "agent-skills",
    "dsh",
    "dsh-spicy",
    "nsfw-content-creation"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.4 <4",
    "react": ">=18.2.0 <19",
    "react-dom": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "contributors": [
    "shanliuling (original DSH image-generation integration)"
  ],
  "bin": {
    "qwen-studio-maintain": "bin/qwen-studio-maintain.mjs"
  }
}
